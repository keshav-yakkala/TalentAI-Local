# TalentAI — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=TalentAI
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ── API ───────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension
DATABASE_URL=postgresql+asyncpg://talentai:talentai@localhost:5432/talentai_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: grok, ollama, gemini, openai
LLM_PROVIDER=grok
LLM_MODEL=grok-2-latest
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Grok AI (xAI)
GROK_API_KEY=xai-YOUR-GROK-API-KEY-HERE
GROK_BASE_URL=https://api.x.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Embeddings ────────────────────────────────────────────────────────────────
# Options: sentence_transformers, ollama, gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: local, s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# ── Whisper ───────────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# ── RAG Configuration ─────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_RERANK_TOP_K=3

# ── Screening Weights (must sum to 1.0) ───────────────────────────────────────
SCREENING_WEIGHT_REQUIRED_SKILLS=0.30
SCREENING_WEIGHT_EXPERIENCE=0.20
SCREENING_WEIGHT_PROJECTS=0.20
SCREENING_WEIGHT_PREFERRED_SKILLS=0.10
SCREENING_WEIGHT_EDUCATION=0.05
SCREENING_WEIGHT_DOMAIN=0.05
SCREENING_WEIGHT_SEMANTIC_MATCH=0.10

# ── Observability (optional) ──────────────────────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

LOG_LEVEL=INFO
